# The Exclusive-tier counterpart to gnwes-counter-template.yaml.tmpl --
# identical counter actor app, pointed at gnwes-counter-exclusive-workerpool
# instead (workerSelector matches that WorkerPool's metadata.labels, not its
# pod-template labels).
#
# Not a Kubernetes CRD: create with
#   kubectl ate create actor-template -f gnwes-counter-exclusive-template.yaml.tmpl
# after resolving the ko:// image reference.
metadata:
  atespace: ate-demo-counter
  name: gnwes-counter-exclusive
workerSelector:
  matchLabels:
    workload: gnwes-counter-exclusive
containers:
- name: counter
  image: ko://go.ate.dev/substrate/demos/counter
  command:
  - /ko-app/counter
  - --extra-port=9090
  - --tcp-port=9091
  wakeupProbe:
    httpGet:
      path: /readyz
      port: 80
  volumeMounts:
  - name: data
    mountPath: /home/counter
resources:
  limits:
    cpuMillicores: 1000
    memoryBytes: 536870912 # 512Mi
snapshotConfig:
  preferredFidelity: SNAPSHOT_FIDELITY_MEMORY
volumes:
- name: data
  durableDir: {}
