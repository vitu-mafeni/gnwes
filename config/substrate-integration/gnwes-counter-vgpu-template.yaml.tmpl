# The Volcano-vGPU counterpart to gnwes-counter-template.yaml.tmpl --
# identical counter actor app, pointed at gnwes-counter-vgpu-workerpool
# instead. Create 3 of these (gnwes-actor-vgpu-1/2/3) against the same
# template to actually exercise sharing: gnwes-counter-vgpu-workerpool has
# 3 replicas, so all 3 actors run concurrently on 3 separate worker pods,
# each holding its own small vgpu slice -- real multiple-tenants-on-one-
# physical-GPU sharing, not actors taking turns.
#
# Not a Kubernetes CRD: create with
#   kubectl ate create actor-template -f gnwes-counter-vgpu-template.yaml.tmpl
# after resolving the ko:// image reference.
metadata:
  atespace: ate-demo-counter
  name: gnwes-counter-vgpu
workerSelector:
  matchLabels:
    workload: gnwes-counter-vgpu
containers:
- name: counter
  image: ko://go.ate.dev/substrate/demos/counter
  command:
  - /ko-app/counter
  - --extra-port=9090
  - --tcp-port=9091
  wakeupProbe:
    httpGet:
      path: /readyz
      port: 80
  volumeMounts:
  - name: data
    mountPath: /home/counter
resources:
  limits:
    cpuMillicores: 1000
    memoryBytes: 536870912 # 512Mi
snapshotConfig:
  preferredFidelity: SNAPSHOT_FIDELITY_MEMORY
volumes:
- name: data
  durableDir: {}
