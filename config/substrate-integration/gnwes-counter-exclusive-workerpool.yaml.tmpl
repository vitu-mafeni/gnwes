# A real Agent Substrate WorkerPool (apiVersion ate.dev/v1), the Exclusive
# (VFIO hot-attach) counterpart to gnwes-counter-workerpool.yaml.tmpl's
# Backend=Shared pool. Same counter actor app, different sandbox class and
# GPU mechanism -- see gnwes-counter-exclusive-pool.yaml and
# REPRODUCTION-GUIDE.md's "Is this real, or simulated?" table.
#
# sandboxClasses: [microvm] selects agent-substrate's own
# cmd/ateworker-microvm (Kata on cloud-hypervisor) instead of
# cmd/ateworker-gvisor -- a real, already-shipped worker binary (confirmed
# via pkg/sandboxclass.All() and docs/reference/sandbox-classes.md in the
# real agent-substrate/substrate repo), not something GNWES builds. It needs
# this node's kernel/rootfs/cloud-hypervisor/virtiofsd assets already staged
# in rustfs -- see microvm-assets-upload-job.yaml, already run once against
# this cluster's ate-system (2026-11-12).
#
# ate.dev/kvm is atelet's own device-plugin-advertised extended resource,
# gating this pod onto a KVM-capable node only (confirmed in
# agent-substrate's workerpool_apply.go's maybeApplyMicroVMPodShape) -- not
# something GNWES invented or needs to request a device plugin for itself.
#
# spec.template.labels carries three things podgate-webhook (../webhook/
# podgate-webhook.yaml) reads to decide what to inject into this pool's
# pods, since WorkerPoolPodTemplate has no scheduling-gate, sidecar, or
# volume field of its own:
#   gnwes.io/gpu-pool:     gnwes-counter-exclusive-pool  (which GPUWorkerPool
#                          gates/attaches against)
#   gnwes.io/gpu-backend:  Exclusive                     (inject the
#                          substrate-gpu-bridge sidecar + shared
#                          /run/vc/vm volume, not just the gate)
#   gnwes.io/atespace:     ate-demo-counter               (passed to the
#                          injected sidecar's -atespace flag)
#
# serviceAccountName must be the identity config/webhook/bridge-rbac.yaml
# grants get+patch on vmgpuattachments to -- the injected bridge sidecar has
# no other way to read/write its own pod's VMGPUAttachment.
#
# workerImage uses a ko:// reference exactly like upstream's own templates;
# resolve it the same way demos/counter does before applying -- do not
# hardcode a resolved sha256 digest here.
apiVersion: ate.dev/v1
kind: WorkerPool
metadata:
  name: gnwes-counter-exclusive
  namespace: ate-demo-counter
  labels:
    workload: gnwes-counter-exclusive
spec:
  replicas: 1
  workerImage: ko://go.ate.dev/substrate/cmd/ateworker-microvm
  sandboxClasses:
  - name: microvm
    # Opt-in: use the custom, driver-included Kata image
    # (config/vmgpu/build-nvidia-kata-image.sh,
    # sandboxconfig-microvm-nvidia-gpu.yaml) instead of the stock,
    # driver-less one every other sandboxClasses entry on this cluster
    # still gets by default (no configRef here, or omitted entirely).
    # Changing an EXISTING pod's configRef has no effect until that
    # pod is recreated (SandboxConfig resolution happens at VM
    # creation, same "admission/creation-time only" limitation
    # podgate-webhook's own mutations have) -- confirmed the hard way
    # (2026-11-15): delete the pod, don't just patch the WorkerPool, to
    # actually pick this up. Live on this cluster as of 2026-11-15
    # (applied via `kubectl patch`, now reflected here too).
    configRef:
      name: microvm-nvidia-gpu
  template:
    labels:
      gnwes.io/gpu-pool: gnwes-counter-exclusive-pool
      gnwes.io/gpu-backend: Exclusive
      gnwes.io/atespace: ate-demo-counter
    # Pinned to this cluster's one GPU-VFIO-bound node: ate.dev/kvm alone
    # isn't enough if more than one node advertises it (e.g. a control-plane
    # node that also happens to have /dev/kvm) -- the real GPU this pool's
    # VFIOGPUPool references is physically on one specific node's PCI bus,
    # so this workload must land there specifically, not just "somewhere
    # with KVM". Deliberately a generic node label, not a hardcoded
    # hostname (this project's own cluster's GPU node happens to be named
    # dcn-gpu-0, but that name is not portable to a different cluster) --
    # apply it once per cluster:
    #   kubectl label node <your-vfio-gpu-node> gnwes.io/exclusive-gpu-node=true
    nodeSelector:
      gnwes.io/exclusive-gpu-node: "true"
    serviceAccountName: gnwes-substrate-gpu-bridge
    resources:
      limits:
        cpu: "2"
        memory: 2Gi
        ate.dev/kvm: "1"
      requests:
        cpu: 500m
        memory: 2Gi
